[32m+[m[32m                    <h3>OFFERINGS</h3>[m
[32m+[m[32m                    <ul class="is-goals-list">[m
[32m+[m[32m                        <li>Preschool and Elementary (Nursery to Grade 6).</li>[m
[32m+[m[32m                        <li>Junior High School (Grades 7 to 10).</li>[m
[32m+[m[32m                        <li>Senior High School (Grades 11 and 12).</li>[m
[32m+[m[32m                        <li>Special Education (SPED) Program.</li>[m
[32m+[m[32m                    </ul>[m
[32m+[m[32m                </div>[m
[32m+[m[41m            [m
